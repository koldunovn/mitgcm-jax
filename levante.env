# This project's machine paths on DKRZ Levante (docs plan 20261006 Task 5): mitjax/paths.py has neutral defaults and
# derives every location from MJX_WORK; the python is env `mitjax` (docs/ENV.md). Sourced by every batch script and
# tier runner; source it by hand before running anything on Levante:
#     . levante.env
# A value already set in the environment wins (a job or probe that points a location elsewhere keeps it).
export MJX_WORK=${MJX_WORK:-/work/ab0995/a270088/MITjax}
export MJX_PYTHON=${MJX_PYTHON:-/work/ab0995/a270088/mambaforge/envs/mitjax/bin/python}
# The conda/mamba installation that holds env `mitjax` (scripts/make_env.sbatch creates the env in it).
export MJX_CONDA_BASE=${MJX_CONDA_BASE:-/work/ab0995/a270088/mambaforge}
# Slurm logs: the batch scripts' own default is `slurm-<job name>-<job id>.out` in the submit directory (#SBATCH
# lines cannot expand variables); sbatch's SBATCH_OUTPUT overrides that default, so every job submitted from a shell
# that sourced this file logs to $MJX_WORK/logs/<job name>-<job id>.out (`sbatch -o` on the command line still wins).
export SBATCH_OUTPUT=${SBATCH_OUTPUT:-$MJX_WORK/logs/%x-%j.out}
# Our tiers must never turn a lost oracle into a green run of skips: with this set, a test file whose oracle data
# ($MJX_REFERENCE, replay runs) or lessons digests are absent FAILS instead of skipping (mitjax/tests/oracle.py,
# conftest.py). A user's machine leaves it unset; a run that wants the user's behaviour sets MJX_REQUIRE_ORACLE=0.
export MJX_REQUIRE_ORACLE=${MJX_REQUIRE_ORACLE:-1}
